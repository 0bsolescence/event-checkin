<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Header: logo + title left, live headcount right, on the primary color.
         Every color here is set at runtime from the theme file; the values in
         colors.xml are the neutral defaults that show before one is imported. -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/brand_primary"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:adjustViewBounds="true"
            android:maxWidth="180dp"
            android:layout_marginEnd="12dp"
            android:visibility="gone"
            android:contentDescription="@string/logo_description" />

        <TextView
            android:id="@+id/app_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="24sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/brand_on_primary"
            android:text="@string/app_name" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/headcount_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/brand_on_primary"
                android:text="@string/headcount_label" />

            <TextView
                android:id="@+id/headcount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:textSize="34sp"
                android:textStyle="bold"
                android:textColor="@color/brand_on_primary"
                android:text="@string/zero" />
        </LinearLayout>

        <!-- Setup menu: theme and roster import. Long-pressing the title opens
             the same menu, for anyone who reaches for that first. -->
        <Button
            android:id="@+id/setup"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingLeft="0dp"
            android:paddingRight="0dp"
            android:textSize="22sp"
            android:text="@string/setup_glyph"
            android:contentDescription="@string/setup_title" />
    </LinearLayout>

    <!-- Two rows, not one: three touch-sized buttons plus the picker on a single
         horizontal LinearLayout would squeeze the spinner to nothing on a phone
         and clip the last button, the same failure cross-vendor review caught on
         the Windows toolbar. The buttons share the second row by equal weight,
         so none of them can be pushed off-screen at any width. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/event_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/event_label"
                android:paddingEnd="8dp" />

            <Spinner
                android:id="@+id/event_spinner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/new_event"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/new_event" />

            <Button
                android:id="@+id/end_event"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/end_event" />

            <Button
                android:id="@+id/export_csv"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/export_csv" />
        </LinearLayout>
    </LinearLayout>

    <ListView
        android:id="@+id/attendance"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brand_primary"
        android:textColor="@color/brand_on_primary"
        android:padding="10dp"
        android:text="@string/status_starting" />
</LinearLayout>
